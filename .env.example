# --- GitContainer core (required for local GitHub -> AI -> Dockerfile flow) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- GitContainer Cloud (optional; only needed for Cloud Run deployment) ---
# Local Dockerfile generation works WITHOUT these. Set them to enable
# "Deploy to Cloud Run".
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GCP_ARTIFACT_REGISTRY=gitcontainer-images
# Optional fixed Cloud Run service name. Leave empty to derive it from the repo.
# GCP_SERVICE_NAME=

# --- Server (optional) ---
# PORT=8000
# HOST=0.0.0.0

# --- Optional telemetry (off when unset) ---
# FASTAPI_ANALYTICS_KEY=
