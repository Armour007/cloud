# ============================================================
# GitContainer Cloud — environment template
# Copy to .env and fill in ONLY what you need. Never commit .env.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Windows cmd / Unix:  copy .env.example .env  /  cp .env.example .env
# ============================================================

# --- AI provider ------------------------------------------------
# Which AI generates your Dockerfiles. Options: openrouter | gemini | groq | openai
# Default is openrouter (free-tier/free-model support, no card needed).
AI_PROVIDER=openrouter

# OpenRouter (recommended — free models available, https://openrouter.ai/keys)
# Default model "openrouter/free" auto-selects a currently available free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Gemini (Google free tier, https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (fast inference, https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional legacy provider, paid — never required)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Google Cloud (only needed to Deploy to Cloud Run) ----------
# Local Dockerfile generation works WITHOUT these.
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GCP_ARTIFACT_REGISTRY=gitcontainer-images
# Optional fixed Cloud Run service name. Leave empty to derive it from the repo.
# GCP_SERVICE_NAME=

# --- Server (optional) ------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Optional telemetry (off when unset) ------------------------
# FASTAPI_ANALYTICS_KEY=
